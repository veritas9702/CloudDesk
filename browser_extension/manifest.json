{
  "manifest_version": 3,
  "name": "CloudDesk 权限助手",
  "version": "0.1.5",
  "description": "在正常登录的 Cloudflare 令牌页面自动填写并校验 CloudDesk 所需权限，最终创建由您确认。",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dash.cloudflare.com/*"
      ],
      "js": [
        "catalog.js",
        "form.js",
        "assistant.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://dash.cloudflare.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "CloudDesk 权限助手",
    "default_popup": "popup.html"
  }
}